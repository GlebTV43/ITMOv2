    {
      "id": "9b400308-da7d-f403-5a5d-3b66046d9e90",
      "name": "Проверить событие Issue opened",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst event = input.body && typeof input.body === 'object' ? input.body : null;\nif (event && (input.headers?.['x-github-event'] !== 'issues' || event.action !== 'opened' ||\n    event.repository?.full_name?.toLowerCase() !== 'glebtv43/itmov2')) return [];\nconst issue = event ? event.issue : input;\nif (!issue || issue.pull_request || issue.state !== 'open' || typeof issue.id !== 'number' ||\n    !Number.isSafeInteger(issue.number) || !issue.title?.startsWith('[7.2] ')) return [];\nreturn [{json:{issue_id:String(issue.id), issue_number:issue.number, title:issue.title.slice(6),\n  body:typeof issue.body === 'string' ? issue.body : '', author:issue.user?.login ?? '',\n  first_contributor:issue.author_association === 'NONE', created_at:issue.created_at,\n  autofix_requested:issue.user?.login?.toLowerCase() === 'glebtv43' &&\n    (issue.labels || []).some(label => label.name === 'ai-autofix')}}];"
      }
    },
