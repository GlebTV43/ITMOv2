    {
      "id": "cd1631fb-391c-c385-0e21-e5cd5aa7ec09",
      "name": "Эскалировать при confidence ниже 0.8",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        0
      ],
      "parameters": {
        "jsCode": "const reply = $input.first().json;\nconst original = $('Проверить событие Issue opened').first().json;\nconst confidence = typeof reply.confidence === 'number' && reply.confidence >= 0 && reply.confidence <= 1 ? reply.confidence : 0;\nconst type = confidence >= 0.8 && ['bug','task','feature'].includes(reply.type) ? reply.type : 'unknown';\nreturn [{json:{...original,type,confidence}}];"
      }
    },
