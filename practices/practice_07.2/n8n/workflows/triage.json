      "parameters": {
        "jsCode": "const number = 0; // Для локального запуска укажите номер Issue.\nif (!Number.isSafeInteger(number) || number < 1) throw new Error('Укажите номер тестового Issue.');\nreturn [{json:{number}}];"
      }
