      "name": "Вернуть type и confidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst result = data.output ?? data.text ?? data;\nconst type = ['bug','task','feature','unknown'].includes(result.type) ? result.type : 'unknown';\nconst confidence = Number.isFinite(result.confidence) && result.confidence >= 0 && result.confidence <= 1\n  ? result.confidence : 0;\nreturn [{ json: { type, confidence } }];"
      }
    }
