    {
      "id": "2fad32ef-1405-5560-e8c2-2a2f75091831",
      "name": "Проверить область изменений PR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4160,
        0
      ],
      "parameters": {
        "jsCode": "const files = $input.first().json.body;\nconst pr = $('Открыть PR в тестовую ветку').first().json;\nconst sent = $('Записать исправление в ветку').first().json;\nconst patch = $('Разрешить push только после тестов').first().json;\nif (!Array.isArray(files) || files.length !== 1 || files[0].filename !== \"practices/practice_07.1/books/views.py\" ||\n    files[0].additions !== 1 || files[0].deletions !== 1 ||\n    !files[0].patch?.split('\\n').includes('+' + patch.replacement) ||\n    pr.base.ref !== \"demo/practice-07.2-booksharing\" || pr.base.sha !== patch.commit || pr.head.ref !== patch.branch ||\n    !/^[a-f0-9]{40}$/.test(pr.head.sha) || pr.head.sha !== sent.commit?.sha) {\n  throw new Error('PR не соответствует проверенному изменению.');\n}\nreturn [{json:{pr:pr.number,url:pr.html_url,head:pr.head.sha,base:pr.base.sha,diff:files[0].patch}}];"
      }
    },
    {
      "id": "99627d50-69ea-04b4-a4c7-6692c2b02487",
      "name": "Вторая модель · ревью исправления",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
