    {
      "id": "71ec5b93-252a-f97e-b788-b3dbf3eb72f2",
      "name": "Посчитать Δ к прошлой неделе",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        0
      ],
      "parameters": {
        "jsCode": "const current = $('Сгруппировать по типу и автору').first().json;\nconst row = $input.first().json;\nconst previous = row.week_end === current.previousWeekEnd ? JSON.parse(row.counts_json) : null;\nconst previousTypes = previous ? JSON.parse(row.types_json) : null;\nconst difference = (counts, old) => Object.fromEntries(Object.entries(counts).map(([key, value]) =>\n  [key, old ? value - (old[key] ?? 0) : null]));\nreturn [{json:{...current, previousSource:previous ? row.source : null,\n  delta:difference(current.counts,previous), typeDelta:difference(current.types,previousTypes)}}];"
      }
    },
    {
      "id": "50f96a9b-f6ac-3cdc-a702-9f37ed61a108",
      "name": "Сформулировать AI-комментарий недели",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
