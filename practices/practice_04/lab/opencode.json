{
  "$schema": "https://opencode.ai/config.json",
  "model": "vsellm/anthropic/claude-sonnet-4.6",
  "provider": {
    "vsellm": {
      "env": ["VSELLM_API_KEY"],
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.data-light.ru/v1",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "anthropic/claude-sonnet-4.6": {
          "tool_call": true,
          "limit": {"context": 200000, "output": 8192}
        }
      }
    }
  },
  "permissions": [
    {"action": "*", "resource": "*", "effect": "allow"}
  ],
  "mcp": {
    "servers": {
      "subscriber_contract": {
        "type": "local",
        "command": ["python", "mcp/server.py"],
        "cwd": ".",
        "environment": {
          "PYTHONIOENCODING": "utf-8"
        },
        "disabled": false,
        "codemode": false
      }
    }
  }
}
